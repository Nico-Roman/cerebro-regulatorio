# RegulaMED — variables de entorno
# Copia este archivo a .env.local y completa los valores reales.
# .env.local (y cualquier .env*) ya está en .gitignore: nunca se sube al repo.

# ── Sitio (Fase actual — Vercel) ────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://cerebro-regulatorio.vercel.app

# ── Contacto (formulario → Resend) ──────────────────────────────────────────
# Sin esto el formulario responde 503 y no envía nada (ver app/api/contacto/route.ts).
RESEND_API_KEY=
CONTACTO_FROM=RegulaMED <onboarding@resend.dev>
CONTACTO_TO=contacto@regulamed.cl

# ============================================================================
# Variables de fases futuras (ver PLAN-migracion-railway.md).
# Déjalas vacías hasta implementar cada fase; no son necesarias hoy.
# ============================================================================

# ── Fase 2: dominio propio + Railway ────────────────────────────────────────
# NEXT_PUBLIC_SITE_URL=https://regulamed.cl
# NODE_ENV=production

# ── Base de datos + autenticación (Better Auth + Google) — ACTIVAS ─────────
# Sin DATABASE_URL la app no arranca: el buscador exige sesión y la sesión vive
# en Postgres. En Railway usa la URL PRIVADA (postgres.railway.internal).
DATABASE_URL=
# Secreto de firma de sesiones. Generar con: openssl rand -base64 32
BETTER_AUTH_SECRET=
# URL pública desde donde se sirve la app (Google valida el retorno contra esto).
BETTER_AUTH_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Correos con acceso al panel de administración (separados por coma).
ADMIN_EMAILS=

# Enlace mágico por correo: se enciende con 1, pero solo después de verificar
# el dominio en Resend (SPF/DKIM). Antes de eso los correos de acceso caen a spam.
AUTH_MAGIC_LINK=0
AUTH_EMAIL_FROM=RegulaMED <acceso@regulamed.cl>

# ── Fase 4: agenda (Google Calendar) ────────────────────────────────────────
# GOOGLE_AGENDA_CLIENT_ID=
# GOOGLE_AGENDA_CLIENT_SECRET=
# GOOGLE_REFRESH_TOKEN=
# AGENDA_TZ=America/Santiago

# ── Fase 5: IA (cerebro regulatorio) ────────────────────────────────────────
# LLM_PROVIDER=groq
# LLM_MODEL=openai/gpt-oss-120b
# GROQ_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=
# LLM_CUOTA_DIARIA=20

# ── Observabilidad / integraciones ──────────────────────────────────────────
# CEREBRO_LOG_WEBHOOK=
# SENTRY_DSN=

# Variables que lee la aplicación. Copia a .env.local para desarrollo; en
# producción viven en Railway (servicio cerebro-regulatorio).
#
# Ninguna clave real va en este archivo ni en el repo.

# ── Base ────────────────────────────────────────────────────────────────────
# URL canónica del sitio. De acá salen el sitemap, robots.txt, los metadatos y
# los enlaces de los correos.
NEXT_PUBLIC_SITE_URL=https://regulamed.cl

# ── Base de datos ───────────────────────────────────────────────────────────
# En Railway se referencia el servicio Postgres: ${{Postgres.DATABASE_URL}}
# (red privada). Sin esto el contenedor no arranca: migrate.mjs aborta.
DATABASE_URL=postgres://usuario:clave@localhost:5432/regulamed

# ── Sesión (Better Auth) ────────────────────────────────────────────────────
# Cadena larga al azar: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://regulamed.cl
# Cliente OAuth "web" de Google Cloud. Sin estas dos, nadie puede entrar.
# Redirección autorizada: https://regulamed.cl/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Enlace mágico por correo. Enciéndelo (=1) solo cuando regulamed.cl esté
# verificado en Resend: desde onboarding@resend.dev los correos caen a spam.
AUTH_MAGIC_LINK=0

# ── Correo (Resend) ─────────────────────────────────────────────────────────
RESEND_API_KEY=
CONTACTO_FROM=RegulaMED <contacto@regulamed.cl>
CONTACTO_TO=contacto@regulamed.cl
# Remitente de los correos de acceso; si falta, se usa CONTACTO_FROM.
AUTH_EMAIL_FROM=RegulaMED <acceso@regulamed.cl>

# ── Panel interno ───────────────────────────────────────────────────────────
# Correos con acceso a /admin, separados por coma.
ADMIN_EMAILS=
# Destinatario del resumen semanal; si falta, se usa CONTACTO_TO.
RESUMEN_TO=
# Secreto para que un cron externo pueda pedir el resumen semanal. Sin él, esa
# vía queda cerrada y el resumen solo se genera con sesión de administrador.
CRON_SECRET=

# ── Agenda (Google Calendar) ────────────────────────────────────────────────
# Segundo cliente OAuth, distinto del login: scopes calendar.events y
# calendar.readonly. La app debe estar PUBLICADA en producción, o el refresh
# token caduca a los 7 días.
GOOGLE_CAL_CLIENT_ID=
GOOGLE_CAL_CLIENT_SECRET=
# Se obtiene una vez con: node scripts/google-auth.mjs
GOOGLE_REFRESH_TOKEN=

# ── Capa de IA ──────────────────────────────────────────────────────────────
# Cualquier proveedor compatible con OpenAI. Sin LLM_API_KEY, el modo IA y el
# botón de borrador no aparecen y el buscador funciona igual.
# Ojo con el tier gratuito de Groq: 8.000 tokens/minuto (~3 borradores) y un
# tope diario que se agotó con ~80 borradores el 13-09-2026, compartido por
# todo el sitio. Para uso real, tier Developer (pago por uso).
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
# Opcionales. Esfuerzo de razonamiento: "low" por defecto en gpt-oss; "medium"
# se probó y costó 38 % más sin mejorar las citas. Cuota por persona al día.
# LLM_REASONING_EFFORT=low
# (LLM_CUOTA_DIARIA ya no se usa desde 22-09-2026: el cupo por persona lo
#  deciden los créditos de su plan, ver lib/planes.ts.)
# Ráfaga por persona por minuto, y techo diario de borradores del plan GRATIS
# en todo el sitio (los planes pagados y packs no pasan por este techo).
# LLM_CUOTA_MINUTO=3
# Precio del modelo de LLM_MODEL en US$ por millón (solo si NO es gpt-oss-120b
# en Groq y no hay un modelo activo en /admin/planes). Se usa para el costo de
# cada consulta y el cobro en créditos.
# LLM_USD_MILLON_ENTRADA=0.15
# LLM_USD_MILLON_SALIDA=0.6
# Claves de otros proveedores, para elegir el modelo desde /admin/planes (el
# nombre tiene que terminar en _API_KEY; el panel guarda el nombre, no la clave):
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# DEEPSEEK_API_KEY=
# OPENROUTER_API_KEY=
# LLM_CUOTA_DIARIA_SITIO=400

# ── Video de venta (VSL) en /asesoria ───────────────────────────────────────
# Los 11 caracteres que van después de "v=" en la URL de YouTube. Sube el video
# como "No listado". Sin esta variable, /asesoria muestra un marcador en vez del
# reproductor y la página funciona igual. Es NEXT_PUBLIC_ porque el reproductor
# se arma en el navegador; no es un secreto, el video es público para quien
# tenga el enlace.
NEXT_PUBLIC_VSL_YOUTUBE_ID=

# ── Opcional ────────────────────────────────────────────────────────────────
# Registro paralelo de consultas en n8n → Google Sheets. Postgres es la fuente
# de verdad; esto solo sigue vivo si la variable está puesta. No envía datos de
# la persona (ni correo ni id), solo la pregunta y las señales del motor.
CEREBRO_LOG_WEBHOOK=

# ── Respaldo semanal de Postgres (.github/workflows/respaldo-postgres.yml) ──
# La app NO lee estas dos: las usa solo el workflow de GitHub Actions, y viven
# como secretos en GitHub → Settings → Environments → Production (el mismo
# entorno donde vive CRON_SECRET como secret; no son variables de Railway).
# DATABASE_PUBLIC_URL  URL pública de Postgres en Railway (el servicio Postgres
#                      → pestaña "Connect" → "Public Network"; la privada
#                      .railway.internal no es alcanzable desde GitHub).
# BACKUP_PASSPHRASE    frase larga al azar (openssl rand -base64 32) para
#                      cifrar el volcado antes de subirlo como artefacto; sin
#                      ella el respaldo viajaría en claro.
# DATABASE_PUBLIC_URL=
# BACKUP_PASSPHRASE=
